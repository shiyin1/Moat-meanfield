Notebook[
 {Cell[BoxData[RowBox[{RowBox[{"SetDirectory", "[", 
        RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]], "Input"], 
  Cell["Quartic spatial-momentum coefficient of the pion two-point function", 
   "Title"], Cell["Same setting as phaseZpi.nb / derive/meanfield.nb \
(arXiv:2510.06712): \[CapitalSigma]_\[Pi](p0=0, p) = m\:0304_\[Pi]\262 + \
Z_\[Pi]^\[UpTee] p\262 + W_\[Pi]^\[UpTee] p\:2074 + O(p\:2076). \
Z_\[Pi]^\[UpTee] = \[PartialD]\[CapitalSigma]_\[Pi]/\[PartialD]p\262 |_(p=0) \
(coefficient of p\262, i.e. \275 \[PartialD]\262/\[PartialD]|p|\262), and \
analogously W_\[Pi]^\[UpTee] = \275 \
\[PartialD]\262\[CapitalSigma]_\[Pi]/\[PartialD](p\262)\262 |_(p=0) = (1/4!) \
\[PartialD]\:2074\[CapitalSigma]_\[Pi]/\[PartialD]|p|\:2074 |_(p=0). The \
classical action has no p\:2074 term, so W_\[Pi]^\[UpTee] comes entirely from \
the quark loop.", "Text"], 
  Cell["Derivation (same steps as derive/meanfield.nb, now to p^4)", 
   "Section"], Cell["With p0 = 0 the loop is \[CapitalPi] = -2 h\262 N_c \
T\[CapitalSigma]_n \[Integral]d\263q/(2\[Pi])\263 [ \:1e20(q-p) - q p \
cos\[Theta] \:1e20(q) \:1e20(q-p) ], \:1e20(q) = 1/(q0\262 + q\262 + \
m_f\262). Expand in p with x' = (q-p)\262 = q\262 + p\262 - 2 q p cos\[Theta] \
and take the p\262 and p\:2074 coefficients (G \[Congruent] \:1e20(q), qs = \
|q|, ps = |p|, costhe = cos\[Theta]).", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"xs", "[", "ps_", "]"}], " ", ":=", 
         " ", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", 
           RowBox[{"ps", "^", "2"}], " ", "-", " ", 
           RowBox[{"2", " ", "qs", " ", "ps", " ", "costhe"}]}]}], ";"}], 
     "\n", RowBox[{RowBox[{"integrand", " ", "=", " ", 
         RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"q0", "^", 
                   "2"}], " ", "+", " ", RowBox[{"xs", "[", "ps", "]"}], " ", 
                 "+", " ", "mf2"}], ")"}]}], " ", "-", " ", 
           RowBox[{"qs", " ", "ps", " ", RowBox[{"costhe", "/", RowBox[
                {"(", RowBox[{RowBox[{"(", RowBox[{RowBox[{"q0", "^", "2"}], 
                       " ", "+", " ", RowBox[{"qs", "^", "2"}], " ", "+", 
                       " ", "mf2"}], ")"}], " ", RowBox[{"(", RowBox[
                      {RowBox[{"q0", "^", "2"}], " ", "+", " ", RowBox[
                        {"xs", "[", "ps", "]"}], " ", "+", " ", "mf2"}], 
                     ")"}]}], ")"}]}]}]}]}], ";"}], "\n", 
     RowBox[{"coeffp2", " ", "=", " ", RowBox[{"Expand", "[", 
         RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"D", "[", RowBox[
                    {"integrand", ",", " ", RowBox[{"{", RowBox[{"ps", ",", 
                         " ", "2"}], "}"}]}], "]"}], "/", RowBox[
                  {"2", "!"}]}], " ", "/.", " ", RowBox[{"ps", " ", "->", 
                 " ", "0"}]}], ")"}], " ", "/.", " ", 
           RowBox[{"q0", " ", "->", " ", RowBox[{"Sqrt", "[", RowBox[
                {RowBox[{"1", "/", "G"}], " ", "-", " ", RowBox[{"qs", "^", 
                   "2"}], " ", "-", " ", "mf2"}], "]"}]}]}], "]"}]}], "\n", 
     RowBox[{"coeffp4", " ", "=", " ", RowBox[{"Expand", "[", 
         RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"D", "[", RowBox[
                    {"integrand", ",", " ", RowBox[{"{", RowBox[{"ps", ",", 
                         " ", "4"}], "}"}]}], "]"}], "/", RowBox[
                  {"4", "!"}]}], " ", "/.", " ", RowBox[{"ps", " ", "->", 
                 " ", "0"}]}], ")"}], " ", "/.", " ", 
           RowBox[{"q0", " ", "->", " ", RowBox[{"Sqrt", "[", RowBox[
                {RowBox[{"1", "/", "G"}], " ", "-", " ", RowBox[{"qs", "^", 
                   "2"}], " ", "-", " ", "mf2"}], "]"}]}]}], "]"}]}]}], 
   "Input"], Cell["coeffp2 reproduces -\:1e20\262 + 2 cos\262\[Theta] q\262 \
\:1e20\263 of derive/meanfield.nb. Angular integration:", "Text"], 
  Cell[BoxData[{RowBox[{"Integrate", "[", RowBox[{"coeffp2", ",", " ", 
         RowBox[{"{", RowBox[{"costhe", ",", " ", RowBox[{"-", "1"}], ",", 
             " ", "1"}], "}"}]}], "]"}], "\n", 
     RowBox[{"Integrate", "[", RowBox[{"coeffp4", ",", " ", 
         RowBox[{"{", RowBox[{"costhe", ",", " ", RowBox[{"-", "1"}], ",", 
             " ", "1"}], "}"}]}], "]"}]}], "Input"], 
  Cell["Extract q\262 from each propagator and do the Matsubara sum, F_(k) = \
q^(2k-1) T\[CapitalSigma]_n \:1e20^k (thermal part only, the vacuum part is \
treated in dim. reg. below). Then \[Integral]d\263q/(2\[Pi])\263 = \
\[Integral]q\262 dq \[Integral]dcos\[Theta] /(4\[Pi]\262) gives\n   Z_thr = \
-2 h\262 N_c \[Integral]dq/(2\[Pi]\262 q)  [ -F_(2) + 2/3 F_(3) ]      (as in \
phaseZpi.nb)\n   W_thr = -2 h\262 N_c \[Integral]dq/(2\[Pi]\262 q\263) [ \
F_(3) - 8/3 F_(4) + 8/5 F_(5) ]", "Text"], Cell["Matsubara sums of higher \
powers follow from T\[CapitalSigma]_n \:1e20 = (1 - n_F(E,\[Mu]) - \
n_F(E,-\[Mu]))/(2E) by differentiating w.r.t. E\262 = q\262 + m_f\262:  \
T\[CapitalSigma]_n \:1e20^k = (-1)^(k-1)/(k-1)! \
\[PartialD]^(k-1)/\[PartialD](E\262)^(k-1) T\[CapitalSigma]_n \:1e20. \
Generate the thermal parts of F_(1) ... F_(5):", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"gsum", "[", RowBox[{"e2_", ",", " ", "TT_", 
             ",", " ", "mm_"}], "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{RowBox[{"1", "/", 
                   RowBox[{"(", RowBox[{RowBox[{"Exp", "[", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"Sqrt", "[", "e2", 
                          "]"}], " ", "-", " ", "mm"}], ")"}], "/", "TT"}], 
                         "]"}], " ", "+", " ", "1"}], ")"}]}], " ", "+", " ", 
                 RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"Exp", "[", 
                         RowBox[{RowBox[{"(", RowBox[{RowBox[{"Sqrt", "[", 
                          "e2", "]"}], " ", "+", " ", "mm"}], ")"}], "/", 
                          "TT"}], "]"}], " ", "+", " ", "1"}], ")"}]}]}], 
               ")"}]}], "/", RowBox[{"(", RowBox[{"2", " ", RowBox[
                {"Sqrt", "[", "e2", "]"}]}], ")"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"Do", "[", RowBox[
          {RowBox[{RowBox[{"Sk", "[", "k", "]"}], " ", "=", " ", 
             RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[
                        {"-", "1"}], ")"}], "^", RowBox[{"(", RowBox[
                        {"k", " ", "-", " ", "1"}], ")"}]}], "/", 
                   RowBox[{RowBox[{"(", RowBox[{"k", " ", "-", " ", "1"}], 
                       ")"}], "!"}]}], ")"}], " ", RowBox[{"D", "[", 
                 RowBox[{RowBox[{"gsum", "[", RowBox[{"e2", ",", " ", "TT", 
                       ",", " ", "mm"}], "]"}], ",", " ", RowBox[{"{", 
                     RowBox[{"e2", ",", " ", RowBox[{"k", " ", "-", " ", 
                         "1"}]}], "}"}]}], "]"}]}]}], ",", " ", 
           RowBox[{"{", RowBox[{"k", ",", " ", "1", ",", " ", "5"}], "}"}]}], 
         "]"}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"Fk", "[", RowBox[{"k_", ",", " ", 
             RowBox[{"q_", "?", "NumericQ"}], ",", " ", 
             RowBox[{"mf2_", "?", "NumericQ"}], ",", " ", 
             RowBox[{"T_", "?", "NumericQ"}], ",", " ", 
             RowBox[{"mu_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"q", "^", RowBox[{"(", RowBox[
                  {RowBox[{"2", " ", "k"}], " ", "-", " ", "1"}], ")"}]}], 
             " ", RowBox[{"Sk", "[", "k", "]"}]}], " ", "/.", " ", 
           RowBox[{"{", RowBox[{RowBox[{"e2", " ", "->", " ", RowBox[
                  {RowBox[{"q", "^", "2"}], " ", "+", " ", "mf2"}]}], ",", 
               " ", RowBox[{"TT", " ", "->", " ", "T"}], ",", " ", RowBox[
                {"mm", " ", "->", " ", "mu"}]}], "}"}]}]}], ";"}]}], 
   "Input"], Cell["Simplification by partial integration. On functions of E, \
\[PartialD]/\[PartialD]m_f\262 = (1/2q) \[PartialD]/\[PartialD]q, so all \
derivatives can be moved onto the measure. Write T\[CapitalSigma]_n \:1e20^k \
= (-1)^(k-1)/(k-1)! g^((k-1))(q\262 + m\262) for a generic g and check that \
the angular-integrated integrands are total q-derivatives plus a simple \
remainder (the boundary terms B vanish at q = 0 and, for the thermal part, at \
q \[RightArrow] \[Infinity]):", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{RowBox[{"SS", "[", "k_", "]"}], " ", ":=", " ", 
           RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[
                      {"-", "1"}], ")"}], "^", RowBox[{"(", RowBox[{"k", " ", 
                       "-", " ", "1"}], ")"}]}], "/", RowBox[
                  {RowBox[{"(", RowBox[{"k", " ", "-", " ", "1"}], ")"}], 
                   "!"}]}], ")"}], " ", RowBox[{RowBox[{RowBox[{"Derivative", 
                   "[", RowBox[{"k", " ", "-", " ", "1"}], "]"}], "[", "gg", 
                 "]"}], "[", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", 
                 "mf2"}], "]"}]}]}], ";"}], "\n", 
       RowBox[{"(*", " ", RowBox[{RowBox[{RowBox[{"p", "^", "2"}], ":", " ", 
             RowBox[{RowBox[{"q", "^", "2"}], " ", RowBox[{"(", 
                 RowBox[{RowBox[{RowBox[{"-", "2"}], " ", "S2"}], " ", "+", 
                   " ", RowBox[{RowBox[{"4", "/", "3"}], " ", RowBox[
                      {"q", "^", "2"}], " ", "S3"}]}], ")"}]}]}], " ", "=", 
           " ", RowBox[{RowBox[{"dB", "/", "dq"}], " ", "-", " ", 
             RowBox[{"g", "/", "2"}]}]}], " ", "*)"}]}], "\n", 
     RowBox[{RowBox[{"BZ", " ", "=", " ", 
         RowBox[{RowBox[{RowBox[{"1", "/", "3"}], " ", 
             RowBox[{"qs", "^", "3"}], " ", RowBox[{RowBox[
                {RowBox[{"Derivative", "[", "1", "]"}], "[", "gg", "]"}], 
               "[", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", "mf2"}], 
               "]"}]}], " ", "+", " ", RowBox[{RowBox[{"qs", "/", "2"}], " ", 
             RowBox[{"gg", "[", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", 
                 " ", "mf2"}], "]"}]}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"Simplify", "[", RowBox[
          {RowBox[{RowBox[{"qs", "^", "2"}], " ", RowBox[{"(", RowBox[
                {RowBox[{RowBox[{"-", "2"}], " ", RowBox[{"SS", "[", "2", 
                     "]"}]}], " ", "+", " ", RowBox[{RowBox[{"4", "/", "3"}], 
                   " ", RowBox[{"qs", "^", "2"}], " ", RowBox[{"SS", "[", 
                     "3", "]"}]}]}], ")"}]}], " ", "-", " ", 
           RowBox[{"(", RowBox[{RowBox[{"D", "[", RowBox[{"BZ", ",", " ", 
                   "qs"}], "]"}], " ", "-", " ", RowBox[{RowBox[{"gg", "[", 
                   RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", "mf2"}], 
                   "]"}], "/", "2"}]}], ")"}]}], "]"}], "\n", 
       RowBox[{"(*", " ", RowBox[{RowBox[{RowBox[{"p", "^", "4"}], ":", " ", 
             RowBox[{RowBox[{"q", "^", "2"}], " ", RowBox[{"(", 
                 RowBox[{RowBox[{"2", " ", "S3"}], " ", "-", " ", 
                   RowBox[{RowBox[{"16", "/", "3"}], " ", RowBox[{"q", "^", 
                       "2"}], " ", "S4"}], " ", "+", " ", RowBox[
                    {RowBox[{"16", "/", "5"}], " ", RowBox[{"q", "^", "4"}], 
                     " ", "S5"}]}], ")"}]}]}], " ", "=", " ", 
           RowBox[{RowBox[{"dB", "/", "dq"}], " ", "-", " ", 
             RowBox[{RowBox[{"(", RowBox[{"1", "/", "24"}], ")"}], " ", 
               RowBox[{RowBox[{"(", RowBox[{"dg", "/", "dq"}], ")"}], "/", 
                 "q"}]}]}]}], " ", "*)"}]}], "\n", 
     RowBox[{RowBox[{"BW", " ", "=", " ", 
         RowBox[{RowBox[{RowBox[{"1", "/", "15"}], " ", 
             RowBox[{"qs", "^", "5"}], " ", RowBox[{RowBox[
                {RowBox[{"Derivative", "[", "3", "]"}], "[", "gg", "]"}], 
               "[", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", "mf2"}], 
               "]"}]}], " ", "+", " ", RowBox[{RowBox[{"5", "/", "18"}], " ", 
             RowBox[{"qs", "^", "3"}], " ", RowBox[{RowBox[
                {RowBox[{"Derivative", "[", "2", "]"}], "[", "gg", "]"}], 
               "[", RowBox[{RowBox[{"qs", "^", "2"}], " ", "+", " ", "mf2"}], 
               "]"}]}], " ", "+", " ", RowBox[{RowBox[{"1", "/", "12"}], " ", 
             "qs", " ", RowBox[{RowBox[{RowBox[{"Derivative", "[", "1", 
                   "]"}], "[", "gg", "]"}], "[", RowBox[{RowBox[{"qs", "^", 
                   "2"}], " ", "+", " ", "mf2"}], "]"}]}]}]}], ";"}], "\n", 
     RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[{"qs", "^", "2"}], " ", 
           RowBox[{"(", RowBox[{RowBox[{"2", " ", RowBox[{"SS", "[", "3", 
                   "]"}]}], " ", "-", " ", RowBox[{RowBox[{"16", "/", "3"}], 
                 " ", RowBox[{"qs", "^", "2"}], " ", RowBox[{"SS", "[", "4", 
                   "]"}]}], " ", "+", " ", RowBox[{RowBox[{"16", "/", "5"}], 
                 " ", RowBox[{"qs", "^", "4"}], " ", RowBox[{"SS", "[", "5", 
                   "]"}]}]}], ")"}]}], " ", "-", " ", 
         RowBox[{"(", RowBox[{RowBox[{"D", "[", RowBox[{"BW", ",", " ", 
                 "qs"}], "]"}], " ", "-", " ", RowBox[{RowBox[{"1", "/", 
                 "24"}], " ", RowBox[{RowBox[{"D", "[", RowBox[
                    {RowBox[{"gg", "[", RowBox[{RowBox[{"qs", "^", "2"}], 
                         " ", "+", " ", "mf2"}], "]"}], ",", " ", "qs"}], 
                   "]"}], "/", "qs"}]}]}], ")"}]}], "]"}]}], "Input"], 
  Cell["With g = -(n_F(E,\[Mu]) + n_F(E,-\[Mu]))/(2E) and (dg/dq)/q = (1/E) \
dg/dE this gives\n   Z_thr = -(h\262 N_c/8\[Pi]\262) \[Integral]dq (n_F + \
n\:0304_F)/E\n   W_thr =  (h\262 N_c/48\[Pi]\262) \[Integral]dq [ (n_F + \
n\:0304_F)/(2E\263) - (n_F' + n\:0304_F')/(2E\262) ]\nOnly first derivatives \
of n_F appear, so the 1D form is numerically stable down to T = 1 MeV (F_(5) \
would need n_F'''').", "Text"], Cell["Vacuum part", "Subsection"], 
  Cell["From the dim.-reg. vacuum two-point function (derive/meanfield.nb): \
\[CapitalPi]_vac \[Superset] -(h\262 N_c/16\[Pi]\262) p\262 \[Integral]_0^1 \
dx Log[(m\262 + x(1-x) p\262)/M\262]. The p\:2074 coefficient is UV finite \
and independent of M (no counterterm needed):", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{"(*", " ", RowBox[{RowBox[{"coefficient", " ", "of", " ", 
            RowBox[{"p", "^", "4"}]}], " ", "=", " ", 
          RowBox[{RowBox[{"(", RowBox[{"p", "^", "2"}], ")"}], "^", "2"}]}], 
        " ", "*)"}], "\n", RowBox[
       {RowBox[{"-", RowBox[{"(", RowBox[{RowBox[{"h", "^", "2"}], " ", 
              RowBox[{"Nc", "/", RowBox[{"(", RowBox[{"16", " ", RowBox[
                     {"Pi", "^", "2"}]}], ")"}]}]}], ")"}]}], " ", 
        RowBox[{"Integrate", "[", RowBox[{RowBox[{"SeriesCoefficient", "[", 
              RowBox[{RowBox[{"Log", "[", RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"m", "^", "2"}], " ", "+", " ", RowBox[
                         {"x", " ", RowBox[{"(", RowBox[{"1", " ", "-", " ", 
                          "x"}], ")"}], " ", "p2"}]}], ")"}], "/", 
                    RowBox[{"M", "^", "2"}]}], "]"}], ",", " ", 
                RowBox[{"{", RowBox[{"p2", ",", " ", "0", ",", " ", "1"}], 
                  "}"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[{"x", ",", 
                " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}]], "Input"], 
  Cell["The same result follows from the 1D formula with the vacuum part \
g_vac = 1/(2E): (h\262 N_c/48\[Pi]\262) \[Integral]dq (-1/(2E\263)) = -h\262 \
N_c/(96\[Pi]\262 m\262). Hence W_vac = -h\262 N_c/(96\[Pi]\262 m_f\262) < 0: \
in vacuum the quartic term is negative. At T = 0 and \[Mu] > m_f the Fermi \
sea gives W = h\262 N_c/(96\[Pi]\262 p_F (\[Mu] + p_F)) > 0.", "Text"], 
  Cell["Vacuum part with a 3D momentum cutoff", "Subsection"], 
  Cell["Alternative: cut the vacuum part sharply at |q| < \[CapitalLambda] \
(as \[CapitalLambda]vac in renorm_finitep_v2/quakr_prop/vacuum_cut), thermal \
parts uncut. With a cutoff neither the shift invariance of \
\[Integral]\:1e20(q-p) nor the partial integration above hold (boundary terms \
at q = \[CapitalLambda]), so go back to the expansion integrand with the \
vacuum parts of T\[CapitalSigma]_n \:1e20^k:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"gvac", "[", "e2_", "]"}], " ", ":=", 
         " ", RowBox[{"1", "/", RowBox[{"(", RowBox[{"2", " ", RowBox[
                {"Sqrt", "[", "e2", "]"}]}], ")"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"Do", "[", RowBox[
          {RowBox[{RowBox[{"Svac", "[", "k", "]"}], " ", "=", " ", 
             RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[
                    {RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"-", 
                          "1"}], ")"}], "^", RowBox[{"(", RowBox[{"k", " ", 
                          "-", " ", "1"}], ")"}]}], "/", RowBox[{RowBox[
                          {"(", RowBox[{"k", " ", "-", " ", "1"}], ")"}], 
                          "!"}]}], ")"}], " ", RowBox[{"D", "[", RowBox[
                        {RowBox[{"gvac", "[", "e2", "]"}], ",", " ", RowBox[
                          {"{", RowBox[{"e2", ",", " ", RowBox[{"k", " ", 
                          "-", " ", "1"}]}], "}"}]}], "]"}]}], " ", "/.", 
                   " ", RowBox[{"e2", " ", "->", " ", RowBox[{RowBox[
                        {"qs", "^", "2"}], " ", "+", " ", RowBox[{"m", "^", 
                         "2"}]}]}]}], ",", " ", RowBox[{"m", " ", ">", " ", 
                   "0"}]}], "]"}]}], ",", " ", 
           RowBox[{"{", RowBox[{"k", ",", " ", "1", ",", " ", "5"}], "}"}]}], 
         "]"}], ";"}], "\n", 
     RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Svac", "[", "k", "]"}], 
           ",", " ", RowBox[{"{", RowBox[{"k", ",", " ", "1", ",", " ", 
               "5"}], "}"}]}], "]"}], "\n", 
       RowBox[{"(*", " ", RowBox[{RowBox[{RowBox[{"same", " ", "angular"}], 
             "-", RowBox[{"integrated", " ", RowBox[{"p", "^", "4"}], " ", 
               "integrand", " ", "as", " ", "above"}]}], ",", " ", 
           RowBox[{RowBox[{"q", "^", "2"}], " ", RowBox[{"(", RowBox[
                {RowBox[{"2", " ", RowBox[{"\:1e20", "^", "3"}]}], " ", "-", 
                 " ", RowBox[{RowBox[{"16", "/", "3"}], " ", RowBox[
                    {"q", "^", "2"}], " ", RowBox[{"\:1e20", "^", "4"}]}], 
                 " ", "+", " ", RowBox[{RowBox[{"16", "/", "5"}], " ", 
                   RowBox[{"q", "^", "4"}], " ", RowBox[{"\:1e20", "^", 
                     "5"}]}]}], ")"}]}], ",", " ", 
           RowBox[{"integrated", " ", "up", " ", "to", " ", 
             "\[CapitalLambda]"}]}], " ", "*)"}]}], "\n", 
     RowBox[{"WvacCutSym", " ", "=", " ", RowBox[{"FullSimplify", "[", 
         RowBox[{RowBox[{RowBox[{"-", "2"}], " ", RowBox[{"h", "^", "2"}], 
             " ", RowBox[{"Nc", "/", RowBox[{"(", RowBox[{"4", " ", 
                   RowBox[{"Pi", "^", "2"}]}], ")"}]}], " ", 
             RowBox[{"Integrate", "[", RowBox[{RowBox[{RowBox[{"qs", "^", 
                     "2"}], " ", RowBox[{"(", RowBox[{RowBox[{"2", " ", 
                         RowBox[{"Svac", "[", "3", "]"}]}], " ", "-", " ", 
                       RowBox[{RowBox[{"16", "/", "3"}], " ", RowBox[{"qs", 
                          "^", "2"}], " ", RowBox[{"Svac", "[", "4", "]"}]}], 
                       " ", "+", " ", RowBox[{RowBox[{"16", "/", "5"}], " ", 
                         RowBox[{"qs", "^", "4"}], " ", RowBox[{"Svac", "[", 
                          "5", "]"}]}]}], ")"}]}], ",", " ", RowBox[
                  {"{", RowBox[{"qs", ",", " ", "0", ",", " ", 
                     "\[CapitalLambda]"}], "}"}], ",", " ", RowBox[
                  {"Assumptions", " ", "->", " ", RowBox[{RowBox[{"m", " ", 
                       ">", " ", "0"}], " ", "&&", " ", RowBox[
                      {"\[CapitalLambda]", " ", ">", " ", "0"}]}]}]}], 
               "]"}]}], ",", " ", RowBox[{RowBox[{"m", " ", ">", " ", "0"}], 
             " ", "&&", " ", RowBox[{"\[CapitalLambda]", " ", ">", " ", 
               "0"}]}]}], "]"}]}], "\n", 
     RowBox[{RowBox[{"Limit", "[", RowBox[{"WvacCutSym", ",", " ", 
           RowBox[{"\[CapitalLambda]", " ", "->", " ", "Infinity"}], ",", 
           " ", RowBox[{"Assumptions", " ", "->", " ", 
             RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}], "\n", 
       RowBox[{"(*", " ", RowBox[{RowBox[{RowBox[{"W_cut", " ", "-", " ", 
               RowBox[{"W_dimreg", " ", "for", " ", "\[CapitalLambda]"}]}], 
             " ", ">>", " ", RowBox[{"m", ":", " ", RowBox[
                {RowBox[{"a", " ", "constant"}], " ", "-", RowBox[
                  {RowBox[{"h", "^", "2"}], " ", RowBox[{"Nc", "/", 
                     RowBox[{"(", RowBox[{"192", " ", RowBox[{"\[Pi]", "^", 
                          "2"}], " ", RowBox[{"\[CapitalLambda]", "^", 
                          "2"}]}], ")"}]}]}]}]}]}], ",", " ", 
           RowBox[{RowBox[{"it", " ", "does", " ", "not", " ", "vanish", " ", 
