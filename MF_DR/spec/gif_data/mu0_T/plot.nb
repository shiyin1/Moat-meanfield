      RowBox[{"i", ",", "1", ",", "501", ",", "5"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Reall", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"omega", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"y", "=", 
          RowBox[{"ps", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
