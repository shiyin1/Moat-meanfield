            ",", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\!\(\*SuperscriptBox[SubscriptBox[\(Z\), \(\[Pi]\)], \(\
\[Perpendicular]\)]\)(p=0;T=0,\[Mu]=0)=1 with QCD input\>\"", ",", "Black", 
