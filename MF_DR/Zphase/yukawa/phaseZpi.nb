Cell[BoxData[
 RowBox[{"phaseplot", "=", "\[IndentingNewLine]", 
  RowBox[{"Rasterize", "[", 
   RowBox[{
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Zall", ",", "Zallp2", ",", "Zallp3"}], "}"}], ",", 
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Blend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Blue", ",", "White", ",", "Red"}], "}"}], ",", 
             RowBox[{"Rescale", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], "]"}], 
           "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<\[Mu] [MeV]\>\"", ",", "Black", ",", "15", ",", 
             RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}],
            ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<T [MeV]\>\"", ",", "Black", ",", "15", ",", 
             RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], "]"}],
            ",", 
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\!\(\*SuperscriptBox[SubscriptBox[\(Z\), \(\[Pi]\)], \(\
\[Perpendicular]\)]\)(p=0;T=0,\[Mu]=0)=1 with QCD input\>\"", ",", "Black", 
             ",", "15", ",", 
             RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
            "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Black", ",", "12"}], "}"}]}], ",", 
        RowBox[{"MeshFunctions", "->", 
         RowBox[{"{", 
          RowBox[{"#3", "&"}], "}"}]}], ",", 
        RowBox[{"Mesh", "->", 
         RowBox[{"{", 
          RowBox[{"{", "0.", "}"}], "}"}]}], ",", 
        RowBox[{"MeshStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Black", ",", 
           RowBox[{"Opacity", "[", "0.1", "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}], ",", 
        RowBox[{"AspectRatio", "->", 
