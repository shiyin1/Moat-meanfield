Cell[CellGroupData[{

Cell["equations", "Section",
 CellChangeTimes->{{3.9659559273864594`*^9, 3.965955928960828*^9}, {
  3.965955966555972*^9, 
  3.965955970586339*^9}},ExpressionUUID->"4b17eab0-ebb2-44a8-a7d8-\
b7d400e53395"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nff", "[", 
    RowBox[{"mf2_", ",", "q_", ",", "T_", ",", "\[Mu]_"}], "]"}], ":=", 
   FractionBox["1", 
    RowBox[{
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        SqrtBox[
