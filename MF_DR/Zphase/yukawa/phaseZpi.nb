         RowBox[{"{", 
          RowBox[{"#3", "&"}], "}"}]}], ",", 
        RowBox[{"Mesh", "->", 
         RowBox[{"{", 
          RowBox[{"{", "0.", "}"}], "}"}]}], ",", 
