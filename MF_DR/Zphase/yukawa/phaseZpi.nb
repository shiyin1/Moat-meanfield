              RowBox[{"Blue", ",", "White", ",", "Red"}], "}"}], ",", 
             RowBox[{"Rescale", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], "]"}], 
           "&"}], ")"}]}], ",", 
        RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
        RowBox[{"FrameLabel", "->", 
