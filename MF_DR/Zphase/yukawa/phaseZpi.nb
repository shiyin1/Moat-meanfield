Cell[BoxData[
 RowBox[{"phaseplot", "=", "\[IndentingNewLine]", 
  RowBox[{"Rasterize", "[", 
   RowBox[{
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Zall", ",", "Zallp2", ",", "Zallp3"}], "}"}], ",", 
        RowBox[{"ColorFunction", "->", 
         RowBox[{"(", 
          RowBox[{
