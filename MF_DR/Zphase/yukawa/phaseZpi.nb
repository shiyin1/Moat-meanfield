            RowBox[{
             RowBox[{"{", 
              RowBox[{"Blue", ",", "White", ",", "Red"}], "}"}], ",", 
             RowBox[{"Rescale", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
