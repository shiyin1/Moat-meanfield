Cell[CellGroupData[{

Cell["Second Riemann sheet of Log", "Subsection",
 CellChangeTimes->{{3.957964977172719*^9, 3.957964982542858*^9}, {
  3.957965043006888*^9, 3.957965047163844*^9}, {3.958012919089653*^9, 
  3.958012949069951*^9}},ExpressionUUID->"6a3ac487-9ccc-4ff2-bc7f-\
3b56666372a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PiPiMed3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[Mu]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Nc", " ", 
      SuperscriptBox["h", "2"]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[Mu]", " ", "pF"}], "+", 
      RowBox[{"mq2", " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "pF"}], 
         RowBox[{"\[Mu]", "+", "pF"}]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]], "-", 
            RowBox[{"2", " ", "\[Mu]"}]}], "p"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"p", "+", 
              RowBox[{"2", " ", "pF"}]}], 
             RowBox[{"p", "-", 
              RowBox[{"2", "pF"}]}]], "]"}], "]"}]}], "-", 
         RowBox[{"Log", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"pF", "+", "\[Mu]"}], ")"}], "2"], "mq2"], "]"}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["p", "2"], "+", 
             RowBox[{"4", " ", "mq2"}]}]], "p"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "+", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}], 
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "-", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]"}]}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbar3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_", ",", "\[Mu]_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"PiPiVacRen1", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "+", 
     RowBox[{"PiPiMed3", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[Mu]"}], "]"}], "+", 
     SuperscriptBox["p", "2"], "+", "mPi2"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9579650602071133`*^9, 3.957965068230557*^9}, {
  3.958012953903349*^9, 3.958012971046812*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"4ea68c5e-1968-4f59-a5a4-12a9019f16e0"],

