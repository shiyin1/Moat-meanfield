            RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]"}]}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbarvac3", "[", 
