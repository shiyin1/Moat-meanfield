Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{"MSbarvac3", "[", 
     RowBox[{
      RowBox[{"p", "+", 
       RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]"}]}], ",", 
      "19.346359230155954", ",", "300.", ",", "400."}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"-", "250"}], ",", "250"}], "}"}]}], "]"}]], "Input",
