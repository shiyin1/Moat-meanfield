Cell[CellGroupData[{

Cell["Second Riemann sheet of Log", "Subsection",
 CellChangeTimes->{{3.957964977172719*^9, 3.957964982542858*^9}, {
  3.957965043006888*^9, 3.957965047163844*^9}, {3.958012919089653*^9, 
  3.958012949069951*^9}},ExpressionUUID->"da98c1cc-d700-453a-95f3-\
063ad026c8e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PiPiMed3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[Mu]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Nc", " ", 
      SuperscriptBox["h", "2"]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[Mu]", " ", "pF"}], "+", 
      RowBox[{"mq2", " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "pF"}], 
         RowBox[{"\[Mu]", "+", "pF"}]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]], "-", 
            RowBox[{"2", " ", "\[Mu]"}]}], "p"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"p", "+", 
              RowBox[{"2", " ", "pF"}]}], 
             RowBox[{"p", "-", 
              RowBox[{"2", "pF"}]}]], "]"}], "]"}]}], "-", 
         RowBox[{"Log", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"pF", "+", "\[Mu]"}], ")"}], "2"], "mq2"], "]"}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["p", "2"], "+", 
             RowBox[{"4", " ", "mq2"}]}]], "p"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "+", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}], 
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "-", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]"}]}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbarvac3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_", ",", "\[Mu]_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SigmaPiVacRen", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "+", 
     RowBox[{"PiPiMed3", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[Mu]"}], "]"}]}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9579650602071133`*^9, 3.957965068230557*^9}, {
  3.958012953903349*^9, 3.958012971046812*^9}, {3.9580148885483513`*^9, 
  3.958014893640828*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"9445a4a0-8ae1-476d-bd30-6ac98f10f4b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plot1", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ComplexPlot3D", "[", 
     RowBox[{
      RowBox[{"MSbarvac3", "[", 
       RowBox[{"p", ",", "4283.491034268094", ",", "300.", ",", "301."}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", 
        RowBox[{
         RowBox[{"-", "1000"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "1000"}]}], ",", 
        RowBox[{"1000", "+", 
         RowBox[{"\[ImaginaryI]", " ", "1000"}]}]}], "}"}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"1.", ",", 
         RowBox[{"-", "1."}], ",", "1"}], "}"}]}], ",", 
      RowBox[{"ViewVertical", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[p] [MeV]\>\"", ",", "20", ",", 
           RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", "Black"}],
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[p] [MeV]\>\"", ",", "20", ",", 
           RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", "Black"}],
           "]"}], ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \
\(\[Pi]\)]\)(p) [\!\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\"", ",", "20", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
             "Black"}], "]"}], ",", 
           FractionBox["\[Pi]", "2"]}], "]"}]}], "}"}]}], ",", 
      RowBox[{"TicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"FontSize", "->", "14"}], ",", 
         RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", "Bold"}], 
        "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "700"}], ",", 
      RowBox[{"ImagePadding", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"90", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "10"}], "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Sheet 3\>\"", ",", "20", ",", "Bold", ",", "Black"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1000"}], ",", "0", ",", 
          RowBox[{"9", " ", 
           SuperscriptBox["10", "6"]}]}], "}"}]}], "  ", "]"}], "}"}], 
     "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.957964988270447*^9, 3.957965030789481*^9}, {
