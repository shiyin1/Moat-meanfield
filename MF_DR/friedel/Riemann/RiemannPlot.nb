Cell[CellGroupData[{

Cell["Second Riemann sheet of sqart", "Subsection",
 CellChangeTimes->{{3.957964977172719*^9, 3.957964982542858*^9}, {
  3.957965043006888*^9, 3.957965047163844*^9}, {3.958012919089653*^9, 
  3.958012936982195*^9}},ExpressionUUID->"6d2132de-971a-4d46-b866-\
f66cad5c5311"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PiPiMed2", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[Mu]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Nc", " ", 
      SuperscriptBox["h", "2"]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[Mu]", " ", "pF"}], "+", 
      RowBox[{"mq2", " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "pF"}], 
         RowBox[{"\[Mu]", "+", "pF"}]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]], "-", 
            RowBox[{"2", " ", "\[Mu]"}]}], "p"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"p", "+", 
              RowBox[{"2", " ", "pF"}]}], 
             RowBox[{"p", "-", 
              RowBox[{"2", "pF"}]}]], "]"}], "]"}]}], "-", 
         RowBox[{"Log", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"pF", "+", "\[Mu]"}], ")"}], "2"], "mq2"], "]"}], "+", 
         RowBox[{
          FractionBox[
           RowBox[{"-", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]]}], "p"], " ", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"2", " ", "mq2"}], "+", 
             RowBox[{"p", " ", "pF"}], "+", 
             RowBox[{"\[Mu]", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["p", "2"], "+", 
                RowBox[{"4", " ", "mq2"}]}]]}]}], 
            RowBox[{
             RowBox[{"2", " ", "mq2"}], "-", 
             RowBox[{"p", " ", "pF"}], "+", 
             RowBox[{"\[Mu]", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["p", "2"], "+", 
                RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}]}]}], ")"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbarvac2", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_", ",", "\[Mu]_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SigmaPiVacRen", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "+", 
     RowBox[{"PiPiMed2", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[Mu]"}], "]"}]}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9579650602071133`*^9, 3.957965068230557*^9}, {
  3.9580145210187473`*^9, 3.9580145562488127`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"df2ee8cd-d3ce-42ba-b888-0b3c64325cdb"],

