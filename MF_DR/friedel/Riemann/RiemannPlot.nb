Cell[CellGroupData[{

Cell["equations \[Mu]=400 MeV", "Section",
 CellChangeTimes->{{3.9579643717625093`*^9, 3.957964372996563*^9}, {
  3.957964557589611*^9, 3.957964572777665*^9}, {3.9579649421006813`*^9, 
  3.957964943591894*^9}},ExpressionUUID->"22ba4804-4253-4e6d-9989-\
f991c1c8ee96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nc", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"65", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Nu]", "=", 
   SuperscriptBox["482", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"758", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mq0", "=", "300."}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"mq0", "=", "20.216128183"}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]0", "=", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["mq0", "2"]}], 
    SuperscriptBox["h", "2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mPi2", "=", 
   RowBox[{
    RowBox[{"-", "\[Nu]"}], " ", "+", " ", 
    RowBox[{"\[Lambda]", " ", "\[Rho]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mq2", "=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["h", "2"], " ", "\[Rho]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PiPiVacRen1", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["h", "2"], " ", "Nc"}], 
      RowBox[{"8", " ", 
       SuperscriptBox["\[Pi]", "2"]}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"mq2", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         RowBox[{"Log", "[", 
          FractionBox["mq2", 
           SuperscriptBox["\[CapitalLambda]", "2"]], "]"}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"Log", "[", 
          FractionBox["mq2", 
           SuperscriptBox["\[CapitalLambda]", "2"]], "]"}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["p", "2"], "+", 
             RowBox[{"4", " ", "mq2"}]}]], "p"], " ", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{
             SqrtBox[
              RowBox[{
               SuperscriptBox["p", "2"], "+", 
               RowBox[{"4", " ", "mq2"}]}]], "+", "p"}], 
            RowBox[{
             SqrtBox[
              RowBox[{
               SuperscriptBox["p", "2"], "+", 
               RowBox[{"4", " ", "mq2"}]}]], "-", "p"}]], "]"}]}]}], 
        ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PiPiVacRen1p0", "[", 
    RowBox[{"\[Rho]_", ",", "\[CapitalLambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"PiPiVacRen1", "[", 
       RowBox[{"p", ",", "\[Rho]1", ",", "\[CapitalLambda]"}], "]"}], ",", 
      RowBox[{"p", "->", "0"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Rho]1", "->", "\[Rho]"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SigmaPiVacRen", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["p", "2"], "+", "mPi2", "+", 
     RowBox[{"PiPiVacRen1", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PiPiVacRen1", "[", 
        RowBox[{
         RowBox[{"Re", "[", "p", "]"}], ",", "\[Rho]0", ",", 
         "\[CapitalLambda]"}], "]"}], "-", 
       RowBox[{"PiPiVacRen1p0", "[", 
        RowBox[{"\[Rho]0", ",", "\[CapitalLambda]"}], "]"}]}], ")"}]}], "//", 
    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pF", "=", 
   SqrtBox[
    RowBox[{
     SuperscriptBox["\[Mu]", "2"], "-", "mq2"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PiPiMed", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[Mu]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Nc", " ", 
      SuperscriptBox["h", "2"]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[Mu]", " ", "pF"}], "+", 
      RowBox[{"mq2", " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "pF"}], 
         RowBox[{"\[Mu]", "+", "pF"}]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]], "-", 
            RowBox[{"2", " ", "\[Mu]"}]}], "p"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"p", "+", 
              RowBox[{"2", " ", "pF"}]}], 
             RowBox[{"p", "-", 
              RowBox[{"2", "pF"}]}]], "]"}], "]"}]}], "-", 
         RowBox[{"Log", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"pF", "+", "\[Mu]"}], ")"}], "2"], "mq2"], "]"}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["p", "2"], "+", 
             RowBox[{"4", " ", "mq2"}]}]], "p"], " ", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{
             RowBox[{"2", " ", "mq2"}], "+", 
             RowBox[{"p", " ", "pF"}], "+", 
             RowBox[{"\[Mu]", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["p", "2"], "+", 
                RowBox[{"4", " ", "mq2"}]}]]}]}], 
            RowBox[{
             RowBox[{"2", " ", "mq2"}], "-", 
             RowBox[{"p", " ", "pF"}], "+", 
             RowBox[{"\[Mu]", " ", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["p", "2"], "+", 
                RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}]}]}], ")"}]}]}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbarvac1", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_", ",", "\[Mu]_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SigmaPiVacRen", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "+", 
     RowBox[{"PiPiMed", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[Mu]"}], "]"}]}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
