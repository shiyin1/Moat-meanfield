        RowBox[{
         RowBox[{"-", "1000"}], "-", 
         RowBox[{"\[ImaginaryI]", " ", "1000"}]}], ",", 
        RowBox[{"1000", "+", 
         RowBox[{"\[ImaginaryI]", " ", "1000"}]}]}], "}"}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"1.", ",", 
         RowBox[{"-", "1."}], ",", "1"}], "}"}]}], ",", 
      RowBox[{"ViewVertical", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Re[p] [MeV]\>\"", ",", "20", ",", 
           RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", "Black"}],
           "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Im[p] [MeV]\>\"", ",", "20", ",", 
           RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", "Black"}],
           "]"}], ",", 
         RowBox[{"Rotate", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \
\(\[Pi]\)]\)(p) [\!\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\"", ",", "20", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
             "Black"}], "]"}], ",", 
           FractionBox["\[Pi]", "2"]}], "]"}]}], "}"}]}], ",", 
      RowBox[{"TicksStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"FontSize", "->", "14"}], ",", 
         RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", "Bold"}], 
        "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "700"}], ",", 
      RowBox[{"ImagePadding", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"90", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"10", ",", "10"}], "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Sheet 3\>\"", ",", "20", ",", "Bold", ",", "Black"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1000"}], ",", "0", ",", 
          RowBox[{"9", " ", 
           SuperscriptBox["10", "6"]}]}], "}"}]}], "  ", "]"}], "}"}], 
     "]"}]}], "]"}]}]], "Input",
