Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PiPiMed3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[Mu]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"Nc", " ", 
      SuperscriptBox["h", "2"]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["\[Pi]", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[Mu]", " ", "pF"}], "+", 
      RowBox[{"mq2", " ", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "pF"}], 
         RowBox[{"\[Mu]", "+", "pF"}]], "]"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox["p", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]], "-", 
            RowBox[{"2", " ", "\[Mu]"}]}], "p"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            FractionBox[
             RowBox[{"p", "+", 
              RowBox[{"2", " ", "pF"}]}], 
             RowBox[{"p", "-", 
              RowBox[{"2", "pF"}]}]], "]"}], "]"}]}], "-", 
         RowBox[{"Log", "[", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"pF", "+", "\[Mu]"}], ")"}], "2"], "mq2"], "]"}], "+", 
         RowBox[{
          FractionBox[
           SqrtBox[
            RowBox[{
             SuperscriptBox["p", "2"], "+", 
             RowBox[{"4", " ", "mq2"}]}]], "p"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "+", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}], 
              RowBox[{
               RowBox[{"2", " ", "mq2"}], "-", 
               RowBox[{"p", " ", "pF"}], "+", 
               RowBox[{"\[Mu]", " ", 
                SqrtBox[
                 RowBox[{
                  SuperscriptBox["p", "2"], "+", 
                  RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]"}]}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MSbar3", "[", 
    RowBox[{"p_", ",", "\[Rho]_", ",", "\[CapitalLambda]_", ",", "\[Mu]_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"PiPiVacRen1", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[CapitalLambda]"}], "]"}], "+", 
     RowBox[{"PiPiMed3", "[", 
      RowBox[{"p", ",", "\[Rho]", ",", "\[Mu]"}], "]"}], "+", 
     SuperscriptBox["p", "2"], "+", "mPi2"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
