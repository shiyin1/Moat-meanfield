        RowBox[{"1000", "+", 
         RowBox[{"\[ImaginaryI]", " ", "1000"}]}]}], "}"}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"1.", ",", 
         RowBox[{"-", "1."}], ",", "1"}], "}"}]}], ",", 
