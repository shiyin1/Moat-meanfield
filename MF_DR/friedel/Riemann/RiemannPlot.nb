             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]]}]}], 
          RowBox[{
           RowBox[{"2", " ", "mq2"}], "-", 
           RowBox[{"p", " ", "pF"}], "+", 
           RowBox[{"\[Mu]", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}]}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{"pF", "->", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[Mu]", "2"], "-", "mq2"}]]}], "}"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mq2", "->", 
       SuperscriptBox["300.", "2"]}], ",", 
      RowBox[{"\[Mu]", "->", "301"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"p", ",", "0", ",", "500"}], "}"}]}], "]"}]], "Input",
