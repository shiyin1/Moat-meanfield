          RowBox[{"-", "1000"}], ",", "0", ",", 
          RowBox[{"1.5", " ", 
           SuperscriptBox["10", "6"]}]}], "}"}]}], "  ", "]"}], "}"}], 
     "]"}]}], "]"}]}]], "Input",
