            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalSigma]\), \
\(\[Pi]\)]\)(p) [\!\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\"", ",", "20", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
             "Black"}], "]"}], ",", 
           FractionBox["\[Pi]", "2"]}], "]"}]}], "}"}]}], ",", 
