            SqrtBox[
             RowBox[{
              SuperscriptBox["p", "2"], "+", 
              RowBox[{"4", " ", "mq2"}]}]]}]}]], "]"}]}], ",", 
       RowBox[{
        FractionBox[
         RowBox[{"-", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["p", "2"], "+", 
            RowBox[{"4", " ", "mq2"}]}]]}], "p"], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{
