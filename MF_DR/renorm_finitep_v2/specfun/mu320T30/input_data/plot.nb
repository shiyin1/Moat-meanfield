Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Re1", "=", 
   RowBox[{"Import", "[", "\"\<./RedataT30mu320.dat\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Im1", "=", 
   RowBox[{"Import", "[", "\"\<./ImdataT30mu320.dat\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", "*", "10"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "200"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spec", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "\[Pi]"], "*", 
       FractionBox[
        RowBox[{"Im1", "[", 
         RowBox[{"[", "75", "]"}], "]"}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"Re1", "[", 
           RowBox[{"[", "75", "]"}], "]"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"Im1", "[", 
           RowBox[{"[", "75", "]"}], "]"}], "2"]}]]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intRe", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"Re1", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "201"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intIm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"Im1", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "201"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fIm", "=", 
          RowBox[{"intIm", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"fRe", "=", 
          RowBox[{"intRe", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"1", "/", "\[Pi]"}], ")"}]}], "*", 
         RowBox[{
          RowBox[{"fIm", "[", "#", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"fRe", "[", "#", "]"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"fIm", "[", "#", "]"}], "^", "2"}]}], ")"}]}]}], "&"}]}],
       "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "201"}], "}"}]}], " ", "]"}]}], 
  ";"}]}], "Input",
